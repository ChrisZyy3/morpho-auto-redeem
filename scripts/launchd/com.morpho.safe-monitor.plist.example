<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.morpho.safe-monitor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>src/modes/auto-withdraw/safe-monitor.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/REPLACE_USERNAME/morpho-auto-redeem</string>
  <!-- Restart failures, but leave a clean position_empty / signal exit stopped. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/REPLACE_USERNAME/morpho-auto-redeem/logs/safe-monitor.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/REPLACE_USERNAME/morpho-auto-redeem/logs/safe-monitor.err.log</string>
</dict>
</plist>
