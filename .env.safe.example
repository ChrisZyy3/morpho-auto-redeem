# READ-ONLY monitor only. No main wallet key, bot key, or Morpho authorization.
# Keep the real .env local and untracked.
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/REPLACE_WITH_YOUR_KEY
OWNER_ADDRESS=0xREPLACE_WITH_YOUR_PUBLIC_WALLET_ADDRESS
POLL_MS=1000
MIN_ALERT_USDC=1000
# Emit health/position status even below the alert threshold.
HEARTBEAT_MS=30000
# Warn when no successfully sampled block change is seen for this long.
STALE_MS=120000
