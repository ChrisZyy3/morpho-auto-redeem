# Phase 2 defaults to DRY RUN. Use a separate, local, chmod-600 .env.exit.local.
# Never use the position owner's private key. Never authorize the bot EOA.
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/REPLACE_WITH_YOUR_KEY
OWNER_ADDRESS=0xREPLACE_WITH_POSITION_OWNER
MIN_WITHDRAW_USDC=100
MAX_WITHDRAW_USDC=1000
POLL_MS=5000
MAX_GAS=200000
MAX_FEE_GWEI=5
MAX_PRIORITY_GWEI=0.5
MAX_TX_ETH=0.001
DAILY_GAS_ETH=0.003
CONFIRMATIONS=3
JOURNAL_PATH=state/safe-exit-dry.json
# For --live, choose JOURNAL_PATH=state/safe-exit-live.json
# Required ONLY for --live after deployment, bytecode verification and owner authorization:
# OPERATOR_ADDRESS=0xONE_TIME_BOT
# EXECUTOR_ADDRESS=0xREVIEWED_DEPLOYED_EXECUTOR
# EXECUTOR_CODE_HASH=0xVERIFIED_RUNTIME_BYTECODE_KECCAK256
# BOT_PRIVATE_KEY=LOCAL_ONLY_BOT_KEY
# LIVE_CONFIRMATION=WITHDRAW_TO_OWNER
